{
  "manifest_version": 3,
  "name": "ResearchTogether Capture",
  "version": "1.0.0",
  "description": "Capture highlights from any web page into your ResearchTogether project source library.",
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
